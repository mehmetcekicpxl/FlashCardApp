<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Temayı Light (Aydınlık) moda sabitliyoruz -->
    <style name="Theme.FlashCardApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Ana Renkler -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Arka Plan ve Yüzeyler (Her zaman beyaz) -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/white</item>

        <!-- Giriş Alanları (Input) Stilleri -->
        <item name="textInputStyle">@style/CustomTextInputLayout</item>
        <item name="android:editTextStyle">@style/CustomEditTextStyle</item>
    </style>

    <!-- Yazı yazarken siyah olmasını garanti eden stil -->
    <style name="CustomEditTextStyle" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">#757575</item>
    </style>

    <!-- Kutu çerçevesi ve etiketlerin rengi -->
    <style name="CustomTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">#757575</item>
    </style>

    <style name="PremiumCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="PremiumButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
